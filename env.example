# Supabase project — copy this file to ".env" and fill in real values.
# The URL and anon key are safe to expose in the browser; the anon key only
# allows the row-level-security-scoped actions defined in your policies.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
